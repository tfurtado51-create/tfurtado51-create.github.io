<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Geografia com Antonio</title>
    <style>
        :root {
            --primary: #8e44ad; /* Roxo para Geografia */
            --success: #2ecc71;
            --danger: #e74c3c;
            --bg: #faf7fc;
            --card: #ffffff;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: var(--bg); color: #333; padding: 20px; text-align: center; }
        header { margin-bottom: 20px; }
        h1 { color: var(--primary); font-size: 24px; margin-bottom: 5px; }
        
        #menu-view, #quiz-view { display: none; }
        .active-view { display: block !important; }

        .topic-btn {
            background: var(--card); border: 2px solid var(--primary); color: var(--primary);
            padding: 15px; margin: 10px 0; border-radius: 10px; width: 100%;
            font-size: 18px; font-weight: bold; cursor: pointer; transition: 0.2s;
            display: flex; justify-content: space-between; align-items: center;
        }
        .topic-btn:active { transform: scale(0.98); }
        .stats { font-size: 14px; color: #666; font-weight: normal; }
        
        .rewards-container { margin-top: 30px; background: var(--card); padding: 15px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .badge { display: inline-block; padding: 8px 12px; margin: 5px; border-radius: 20px; background: #e0e0e0; color: #888; font-size: 14px; font-weight: bold; }
        .badge.unlocked { background: #f39c12; color: #fff; box-shadow: 0 2px 4px rgba(243, 156, 18, 0.4); }

        .card { background: var(--card); padding: 20px; border-radius: 15px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); margin-bottom: 20px; min-height: 200px; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-direction: column; }
        .options { display: grid; grid-template-columns: 1fr; gap: 10px; }
        .option-btn { background: var(--primary); color: white; border: none; padding: 15px; border-radius: 10px; font-size: 18px; cursor: pointer; }
        .option-btn:active { opacity: 0.8; }
        .option-btn.correct { background: var(--success); }
        .option-btn.wrong { background: var(--danger); }
        
        .control-btn { margin-top: 20px; background: #555; color: white; border: none; padding: 12px 20px; border-radius: 8px; font-size: 16px; width: 100%; cursor: pointer; display: block; text-decoration: none; box-sizing: border-box;}
        #explanation { margin-top: 15px; padding: 15px; background: #e9ecef; border-radius: 8px; font-size: 16px; display: none; text-align: left; border-left: 4px solid var(--primary); }
    </style>
</head>
<body>

    <header>
        <h1>🗺️ Geografia com Antonio</h1>
        <p id="total-score">Territórios Conquistados: 0</p>
    </header>

    <div id="menu-view" class="active-view">
        <div id="topics-container"></div>
        
        <div class="rewards-container">
            <h3>🏆 Sala do Cartógrafo</h3>
            <div id="badges-container"></div>
        </div>

        <a href="index.html" class="control-btn" style="background: #e67e22; text-decoration: none; text-align: center;">🏠 Voltar ao Início</a>
        
        <button onclick="if(confirm('Zerar progresso de Geografia?')) { localStorage.removeItem('geografiaProgress'); location.reload(); }" style="margin-top: 30px; background: #e74c3c; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-size: 14px;">🔄 Zerar Progresso</button>
    </div>

    <div id="quiz-view">
        <h2 id="quiz-title" style="margin-bottom: 15px; color: #555;">Tema</h2>
        <div class="card">
            <div id="visual-container" style="width: 100%; margin-bottom: 20px; display: flex; justify-content: center; align-items: center; min-height: 50px;"></div>
            <div id="question-text">Pergunta vai aqui?</div>
        </div>
        
        <div class="options" id="options-container"></div>
        <div id="explanation"></div>
        <a id="btn-video" href="#" target="_blank" class="control-btn" style="display:none; background: #e74c3c;">▶️ Assistir Vídeo Explicativo</a>
        <button class="control-btn" id="btn-explanation" onclick="showExplanation()" style="display:none; background: #f39c12;">💡 Ler Explicação</button>
        <button class="control-btn" id="btn-next" onclick="nextQuestion()" style="display:none; background: var(--success);">Próxima Questão ➔</button>
        <button class="control-btn" onclick="showMenu()" style="background: #95a5a6; margin-top: 10px;">Voltar ao Menu</button>
    </div>

    <script>
const db = {
    cartografia: {
        title: "🧭 Tópico Inicial",
        questions: [
            { 
                q: "Estrutura de Geografia pronta para receber mapas e regiões?", 
                options: ["Sim", "Não"], 
                answer: 0, 
                exp: "Módulo pronto para receber os conteúdos da grade do 4º ano." 
            }
        ]
    }
};

const goals = [
    { id: "jovem_bussola", req: 1, name: "🧭 Jovem da Bússola" },
    { id: "explorador_mapas", req: 10, name: "🗺️ Explorador de Mapas (10 acertos)" },
    { id: "mestre_relevo", req: 50, name: "⛰️ Conhecedor do Relevo (50 acertos)" },
    { id: "grande_geografo", req: 100, name: "👑 Grande Geógrafo (100 acertos)" } 
];

let progress = JSON.parse(localStorage.getItem('geografiaProgress')) || {};
let currentTopic = '';
let currentQuestionObj = null; 
let questionsAnswered = 0;
const QUESTIONS_PER_ROUND = 5; 
let hasAnswered = false;
let currentRoundDeck = []; 

function initApp() {
    const container = document.getElementById('topics-container');
    container.innerHTML = '';
    let totalCorrect = 0;

    for (const key in db) {
        if (!progress[key]) progress[key] = { correct: 0, wrong: 0, acertadas: [] };
        totalCorrect += progress[key].correct;
        
        const btn = document.createElement('button');
        btn.className = 'topic-btn';
        btn.innerHTML = `${db[key].title} <span class="stats">✅ ${progress[key].correct} | ❌ ${progress[key].wrong}</span>`;
        btn.onclick = () => startTopic(key);
        container.appendChild(btn);
    }
    
    document.getElementById('total-score').innerText = `Territórios Conquistados: ${totalCorrect}`;
    renderBadges(totalCorrect);
}

function renderBadges(totalCorrect) {
    const container = document.getElementById('badges-container');
    container.innerHTML = '';
    goals.forEach(g => {
        const badge = document.createElement('span');
        badge.className = `badge ${totalCorrect >= g.req ? 'unlocked' : ''}`;
        badge.innerText = g.name;
        container.appendChild(badge);
    });
}

function saveProgress() { localStorage.setItem('geografiaProgress', JSON.stringify(progress)); }

function startTopic(key) {
    currentTopic = key;
    questionsAnswered = 0;
    currentRoundDeck = [];
    
    if (!progress[key].acertadas) progress[key].acertadas = [];
    
    let allStatic = [...db[key].questions];
    let unseenStatic = allStatic.filter(q => !progress[key].acertadas.includes(q.q));
    
    if (unseenStatic.length === 0) {
        progress[key].acertadas = [];
        unseenStatic = [...allStatic];
    }
    
    unseenStatic.sort(() => Math.random() - 0.5); 
    
    while (currentRoundDeck.length < QUESTIONS_PER_ROUND && unseenStatic.length > 0) {
        let newQuestion = unseenStatic.pop();
        if (!currentRoundDeck.some(q => q.q === newQuestion.q)) currentRoundDeck.push(newQuestion);
    }
    
    if(currentRoundDeck.length < QUESTIONS_PER_ROUND) {
       let extra = [...allStatic].sort(() => Math.random() - 0.5);
       while(currentRoundDeck.length < QUESTIONS_PER_ROUND && extra.length > 0) {
           let popExtra = extra.pop();
           if(!currentRoundDeck.some(q => q.q === popExtra.q)) currentRoundDeck.push(popExtra);
       }
    }
    
    document.getElementById('menu-view').classList.remove('active-view');
    document.getElementById('quiz-view').classList.add('active-view');
    document.getElementById('quiz-title').innerText = `${db[key].title}`;
    loadQuestion();
}

function loadQuestion() {
    hasAnswered = false;
    currentQuestionObj = currentRoundDeck[questionsAnswered]; 
    
    document.getElementById('question-text').innerText = currentQuestionObj.q;
    const visualDiv = document.getElementById('visual-container');
    visualDiv.innerHTML = currentQuestionObj.visual ? currentQuestionObj.visual : '';
    visualDiv.style.display = currentQuestionObj.visual ? 'flex' : 'none';
    
    document.getElementById('explanation').style.display = 'none';
    document.getElementById('btn-explanation').style.display = 'none';
    document.getElementById('btn-video').style.display = 'none';
    document.getElementById('btn-next').style.display = 'none';
    
    const optionsDiv = document.getElementById('options-container');
    optionsDiv.innerHTML = '';
    
    currentQuestionObj.options.forEach((opt, index) => {
        const btn = document.createElement('button');
        btn.className = 'option-btn';
        btn.innerText = opt;
        btn.onclick = () => checkAnswer(index, btn);
        optionsDiv.appendChild(btn);
    });
}

function checkAnswer(selectedIndex, btnElement) {
    if (hasAnswered) return;
    hasAnswered = true;
    
    const isCorrect = selectedIndex === currentQuestionObj.answer;
    const options = document.getElementById('options-container').children;

    if (isCorrect) {
        btnElement.classList.add('correct');
        progress[currentTopic].correct++;
        if (!progress[currentTopic].acertadas) progress[currentTopic].acertadas = [];
        if (!progress[currentTopic].acertadas.includes(currentQuestionObj.q)) {
            progress[currentTopic].acertadas.push(currentQuestionObj.q);
        }
    } else {
        btnElement.classList.add('wrong');
        options[currentQuestionObj.answer].classList.add('correct'); 
        progress[currentTopic].wrong++;
    }

    saveProgress();
    questionsAnswered++;
    
    document.getElementById('btn-explanation').style.display = 'block';
    if (currentQuestionObj.video) {
        const btnVideo = document.getElementById('btn-video');
        btnVideo.href = currentQuestionObj.video;
        btnVideo.style.display = 'block';
    }
    
    const btnNext = document.getElementById('btn-next');
    btnNext.innerText = questionsAnswered >= QUESTIONS_PER_ROUND ? "Finalizar Rodada ➔" : "Próxima Questão ➔";
    btnNext.style.display = 'block';
}

function showExplanation() {
    const expDiv = document.getElementById('explanation');
    expDiv.innerText = currentQuestionObj.exp;
    expDiv.style.display = 'block';
    document.getElementById('btn-explanation').style.display = 'none';
}

function nextQuestion() {
    if (questionsAnswered < QUESTIONS_PER_ROUND) {
        loadQuestion();
    } else {
        showMenu();
    }
}

function showMenu() {
    document.getElementById('quiz-view').classList.remove('active-view');
    document.getElementById('menu-view').classList.add('active-view');
    initApp();
}

initApp();
    </script>
</body>
</html>
